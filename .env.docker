# Docker: Laravel uses DB laravel; inventory service uses DB inventory (separate schemas).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel

INVENTORY_DRIVER=http
INVENTORY_HTTP_URL=http://inventory:50052
INVENTORY_GRPC_HOST=inventory:50051

CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=cookie

DB_WRITE_HOST=mysql
DB_READ_HOST=mysql
DB_STICKY=true
CATALOG_CACHE_ENABLED=true
