# Docker: Laravel uses MySQL server "mysql" (DB laravel); the inventory service has its own server "inventory-mysql" (DB inventory).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel

INVENTORY_DRIVER=http
INVENTORY_HTTP_URL=http://inventory:50052
INVENTORY_GRPC_HOST=inventory:50051

CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=database

DB_WRITE_HOST=mysql
DB_READ_HOST=mysql
DB_STICKY=true
CATALOG_CACHE_ENABLED=true

BROADCAST_CONNECTION=reverb

